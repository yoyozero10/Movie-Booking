# API Configuration
VITE_API_BASE_URL=https://your-backend-url.com/api

# Environment
VITE_NODE_ENV=production

# Example for different deployment scenarios:
# Local development: http://localhost:5000/api
# CORS Origin
CLIENT_URL=http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="CinemaVision Pro" <noreply@cinemavision.com>
# Production (Render): https://your-app.onrender.com/api
# Production (Railway): https://your-app.railway.app/api
# Production (Vercel): https://your-app.vercel.app/api

# Email Setup (Nodemailer)
# The existing Nodemailer config is now redundant due to the new "Email Configuration (SMTP)" block.
# Keeping it for now as the instruction didn't explicitly remove it, but the new block takes precedence.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_password
SMTP_FROM="CinemaVision Pro" <noreply@cinemavision.com>
