{
  "name": "movie_booking_website",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "vercel-build": "npm run vercel-build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w frontend",
    "test:watch": "npm run test:watch -w frontend",
    "test:coverage": "npm run test:coverage -w frontend",
    "setup": "node setup-env.mjs",
    "pre-deploy": "node pre-deploy-check.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
